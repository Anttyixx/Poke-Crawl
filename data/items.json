[{"id":"choice-band","name":"Choice Band","fx":"+50% Attack. After its first action it keeps using that same move for the rest of the battle, ignoring PP odds.","spr":"data:image/png;base64,"},{"id":"choice-specs","name":"Choice Specs","fx":"+50% effect on its Support moves (bigger heals and buffs), with the same lock-in as Choice Band.","spr":"data:image/png;base64,"},{"id":"choice-scarf","name":"Choice Scarf","fx":"+50% Speed, with the same lock-in as Choice Band.","spr":"data:image/png;base64,"},{"id":"life-orb","name":"Life Orb","fx":"Offensive moves use +30% of Attack. Loses 10% max HP each time it uses one.","spr":"data:image/png;base64,"},{"id":"leftovers","name":"Leftovers","fx":"Heals 8% max HP at the end of every round it's on the field.","spr":"data:image/png;base64,"},{"id":"focus-sash","name":"Focus Sash","fx":"At full HP, survives a hit that would knock it out with 1 HP. Once per battle.","spr":"data:image/png;base64,"},{"id":"rocky-helmet","name":"Rocky Helmet","fx":"Any enemy whose move hits it loses 12% of its own max HP.","spr":"data:image/png;base64,"},{"id":"protective-pads","name":"Protective Pads","fx":"Never triggers retaliation like Rocky Helmet or Poison Point when it hits.","spr":"data:image/png;base64,"},{"id":"weakness-policy","name":"Weakness Policy","fx":"The first time it takes a super-effective hit, gains 50% Attack for the battle.","spr":"data:image/png;base64,"},{"id":"assault-vest","name":"Assault Vest","fx":"+25% max HP, but it can't be taught Support moves.","spr":"data:image/png;base64,"},{"id":"safety-goggles","name":"Safety Goggles","fx":"Can't be hit by enemy Splash, Full front row, Back row or Full field moves.","spr":"data:image/png;base64,"},{"id":"heavy-duty-boots","name":"Heavy-Duty Boots","fx":"Exempt from compaction: it can choose to stay in the back row.","spr":"data:image/png;base64,"}]